# EAS archives this monorepo from the Git root. This file replaces every
# .gitignore during archive creation, including the mobile workspace rules.

# Root .gitignore exclusions.
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
/.next/
/out/
/build
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env*
!.env.example
!.env.mobile.example
.vercel
supabase/.temp/
*.tsbuildinfo
next-env.d.ts
.env*.local
backups/
/docs/mobile/private/

# Workspace .gitignore exclusions; generated native projects are rebuilt by EAS.
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
/apps/mobile/example
/apps/mobile/ios/
/apps/mobile/android/
/apps/mobile-capacitor-spike/ios/
/apps/mobile-capacitor-spike/android/

# Local/account configuration, signing material, QA evidence, and build artifacts
# are not mobile build inputs. Keep root/workspace manifests, code, and assets.
.git
.codex
.claude
.agents
.npmrc
.env*
credentials.json
*.keystore
*.pfx
/docs/
/marketing-video/

# Finder/iCloud conflict copies are not source inputs.
**/* 2.*
**/* 2
