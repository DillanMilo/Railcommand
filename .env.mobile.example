# Copy to an ignored local environment file for mobile staging work.
# Never place production credentials or user data in a mobile development file.
MOBILE_BUILD_PROFILE=development
MOBILE_APP_ID=io.railcommand.app.dev
MOBILE_EXPECTED_APP_ID=io.railcommand.app.dev
MOBILE_APP_VERSION=0.2.0
MOBILE_BUILD_NUMBER=200001
# Production builds additionally require MOBILE_ALLOW_PRODUCTION_BUILD=release-authorized.

# The guard requires the actual staging project reference and rejects every
# reference listed as production. Project references are identifiers, not keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY
MOBILE_EXPECTED_SUPABASE_PROJECT_REF=YOUR_STAGING_PROJECT_REF
MOBILE_BLOCKED_SUPABASE_PROJECT_REFS=YOUR_PRODUCTION_PROJECT_REF

NEXT_PUBLIC_APP_URL=https://YOUR_STAGING_HOST
MOBILE_EXPECTED_APP_HOST=YOUR_STAGING_HOST
MOBILE_BLOCKED_APP_HOSTS=railcommand.io,www.railcommand.io
