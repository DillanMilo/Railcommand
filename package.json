{
  "name": "railcommand-temp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:earthcam": "mocha --require tsx \"src/lib/earthcam/*.test.ts\"",
    "test:offline": "mocha --require tsx \"src/lib/offline/*.test.ts\"",
    "test:mobile-env": "node --test scripts/mobile-environment-guard.test.mjs",
    "test:expo-staging": "node --test scripts/expo-staging.test.mjs",
    "test:mobile": "npm run test --workspace @railcommand/domain && npm run test --workspace @railcommand/offline && npm run test --workspace @railcommand/api-client && npm run test --workspace @railcommand/mobile && npm run test:mobile-api && npm run test:mobile-links",
    "test:mobile:capacitor-spike": "npm run test --workspace @railcommand/mobile-capacitor-spike",
    "test:mobile-api": "mocha --require tsx \"src/lib/mobile-api/*.test.ts\"",
    "test:mobile-links": "mocha --require tsx \"src/lib/mobile-link-associations.test.ts\"",
    "test:account-deletion": "mocha --require tsx \"src/lib/account-deletion-compliance.test.ts\"",
    "test:staging-account-deletion-verifier": "node --test scripts/verify-staging-account-deletion.test.mjs",
    "verify:mobile:assets": "node scripts/verify-mobile-assets.mjs",
    "verify:mobile:staging": "node --env-file=.env.mobile.local scripts/verify-mobile-staging.mjs",
    "verify:store:reviewer": "node --env-file=.env.mobile.local scripts/verify-store-reviewer.mjs",
    "verify:staging:account-deletion": "node --env-file=.env.mobile.local scripts/verify-staging-account-deletion.mjs",
    "verify:store:media": "node scripts/verify-store-media.mjs",
    "verify:store:media:strict": "node scripts/verify-store-media.mjs --strict",
    "verify:store:metadata": "node scripts/verify-store-metadata.mjs",
    "verify:store:declarations": "node scripts/verify-store-declarations.mjs",
    "verify:store:android-release": "node scripts/verify-android-release-manifest.mjs",
    "generate:store:data-safety": "node scripts/generate-google-play-data-safety-csv.mjs",
    "record:store:reviewer-video": "node scripts/record-ios-reviewer-video.mjs",
    "verify:store:reviewer-video": "node scripts/verify-reviewer-video.mjs",
    "provision:mobile:device-qa": "node --env-file=.env.mobile.local scripts/provision-mobile-device-qa.mjs",
    "mobile:env:check": "node scripts/mobile-environment-guard.mjs",
    "mobile:build": "npm run export --workspace @railcommand/mobile",
    "mobile:prebuild": "npm run prebuild:native --workspace @railcommand/mobile",
    "mobile:doctor": "npx expo-doctor apps/mobile",
    "test:offline:backend": "node --env-file=.env.local scripts/offline-permission-acceptance.mjs",
    "test:offline:browser-qa": "node --env-file=.env.local scripts/offline-browser-qa.mjs",
    "types:gen": "supabase gen types typescript --project-id gwvftrrknusdfdgiwuij > src/lib/supabase/database.ts",
    "test:email": "tsx scripts/test-email.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.106.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.575.0",
    "next": "16.3.3",
    "openai": "^6.39.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.77.0",
    "resend": "^6.12.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.3",
    "mocha": "^11.7.6",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "diff": "^9.0.0",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "serialize-javascript": "^7.0.6"
  }
}
